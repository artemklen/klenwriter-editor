  "instructions": [
    {
      "id": "C66-01",
      "title": "Введи одну латинскую x",
      "instructions": "В редакторе уже стоит каретка между a и b. Нажми x: должно получиться axb.",
      "expectedKey": "KeyX"
    },
    {
      "id": "C66-02",
      "title": "Выдели строку и примени полужирный",
      "instructions": "⌘←, затем ⇧⌘→: выдели всю строку. Shift+Tab переведёт фокус на «Полужирный». Enter применит форматирование и вернёт фокус в редактор.",
      "expectedKey": "Enter"
    },
    {
      "id": "C66-03",
      "title": "Вставь абзац из клавиатурного меню",
      "instructions": "В редакторе ←, затем →: каретка после a. Tab до «Добавить блок», Enter. В открытом списке выбран «Абзац»: Enter. Ожидаются жирная a, пустой абзац, жирная xb; каретка перед xb.",
      "expectedKey": "Enter"
    },
    {
      "id": "C66-04",
      "title": "Подними текущий блок",
      "instructions": "Tab до «Переместить блок». Пока эта кнопка в фокусе, нажми Option+↑. Ожидается порядок a → xb → пустой абзац. Фокус остаётся на кнопке перемещения.",
      "expectedKey": "ArrowUp"
    },
    {
      "id": "C66-05",
      "title": "Удали одну букву",
      "instructions": "Shift+Tab вернёт фокус в редактор. ⌘→, затем Backspace один раз: вместо xb должна остаться x.",
      "expectedKey": "Backspace"
    },
    {
      "id": "C66-06",
      "title": "Отмени удаление",
      "instructions": "Один ⌘Z в редакторе возвращает жирную xb и каретку после b.",
      "expectedKey": "KeyZ"
    },
    {
      "id": "SAVE",
      "title": "Сохрани копию",
      "instructions": "Tab до «Сохранить документ», Enter. Дождись сообщения «Сохранённая копия подтверждена.». Это тестовый host snapshot/ack, не сохранение в CMS.",
      "expectedKey": "Enter"
    },
    {
      "id": "REOPEN",
      "title": "Открой сохранённую копию",
      "instructions": "Tab до «Открыть сохранённую копию», Enter. Дождись сообщения о новой копии ниже. Затем клавишей Tab войди в новый «Документ» и проверь, виден ли фокус. Порядок a → xb → пустой абзац и полужирное начертание должны сохраниться.",
      "expectedKey": "Enter"
    }
  ],
