  "description": "KlenWriter Editor: optional kwdj profile boundary; unpublished bootstrap",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/artemklen/klenwriter-editor.git",
    "directory": "packages/kwdj"
  },
