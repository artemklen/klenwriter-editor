{
  "name": "klenwriter-editor-workspace",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "start": "node spikes/editing-hosts/server.mjs",
    "test": "playwright test",
    "test:headed": "playwright test --headed --workers=1",
    "test:contracts": "node scripts/check-m0-contracts.mjs",
    "check:m0": "node scripts/check-m0-artifacts.mjs",
    "perf:capture": "node scripts/m0-perf/capture.mjs",
    "perf:verify": "node scripts/m0-perf/summarize.mjs --check",
    "report": "playwright show-report",
    "build": "node scripts/build-workspace.mjs",
    "typecheck": "tsc -b --pretty false",
    "check:workspace": "node scripts/check-workspace.mjs",
    "check:packages": "node scripts/check-packages.mjs",
    "test:workspace": "node --test tests/workspace.node.mjs",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets --locked -- -D warnings && cargo test --workspace --locked",
    "check": "npm run check:rust && npm run test:canonical && npm run build && npm run test:codec && npm run test:corpus && npm run test:session && npm run test:transactions && npm run check:metadata && npm run check:workspace && npm run check:packages && npm run test:workspace && npm run check:m0 && npm run perf:verify && npm run test:workspace:browser",
    "test:session": "node --test tests/session.node.mjs",
    "test:transactions": "node --test tests/transactions.node.mjs",
    "test:workspace:browser": "playwright test --config playwright.workspace.config.js",
    "check:metadata": "node scripts/check-package-metadata.mjs",
    "sync:provenance": "node scripts/sync-package-provenance.mjs",
    "test:canonical": "node --test tests/canonical.node.mjs",
    "test:codec": "node --test tests/codec.node.mjs",
    "test:corpus": "node --test tests/corpus-package.node.mjs tests/corpus.node.mjs && node scripts/export-corpus.mjs"
  },
  "engines": {
    "node": ">=24.22.0 <25 || >=26 <27"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "7.0.2"
  },
  "version": "0.0.0",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "npm@11.14.0"
}
