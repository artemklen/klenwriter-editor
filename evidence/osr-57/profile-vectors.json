          "kind": "info",
          "metadata": {
            "label": "Тема",
            "tags": [
              "a",
              "b",
              "c"
            ],
            "pinned": true,
            "rank": 2
          }
        },
        "content": [
          {
            "type": "paragraph",
            "content": []
          }
        ]
      },
      "expected": "invalid-attribute"
