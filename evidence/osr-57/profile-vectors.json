  ],
  "dependencyVectors": [
    {
      "extensions": [
        {
          "id": "b",
          "depends": [
            "a"
          ]
        },
        {
          "id": "a",
          "depends": []
        },
        {
          "id": "c",
          "depends": []
        }
      ],
      "expectedOrder": [
        "a",
        "b",
        "c"
      ]
    },
    {
      "extensions": [
        {
          "id": "a",
          "depends": [
            "b"
          ]
        },
        {
          "id": "b",
          "depends": [
            "a"
          ]
        }
      ],
      "expectedRefusal": "dependency-cycle"
    },
    {
      "extensions": [
        {
          "id": "a",
          "depends": [
            "missing"
          ]
        }
      ],
      "expectedRefusal": "dependency-missing"
    },
    {
      "id": "exact-ascii-case-and-punctuation",
      "extensions": [
        {
          "id": "org.a_1",
          "depends": []
        },
        {
          "id": "org.a",
          "depends": []
        },
        {
          "id": "org.A",
          "depends": []
        },
        {
          "id": "org.a-1",
          "depends": []
        }
      ],
      "expectedOrder": [
        "org.A",
        "org.a",
        "org.a-1",
        "org.a_1"
      ]
    },
    {
      "id": "duplicate-dependency-id",
      "extensions": [
        {
          "id": "same",
          "depends": []
        },
        {
          "id": "same",
          "depends": []
        }
      ],
      "expectedRefusal": "duplicate-id"
