          }
        },
        "content": [
          {
            "type": "paragraph",
            "content": []
          }
        ]
      },
      "expected": "invalid-attribute"
    },
    {
      "id": "integer-range-bound",
      "profile": 1,
      "sample": {
        "type": "callout",
        "attrs": {
          "kind": "info",
          "metadata": {
            "label": "Тема",
            "tags": [
              "ru",
              "note"
            ],
            "pinned": true,
            "rank": 4
          }
        },
        "content": [
          {
            "type": "paragraph",
            "content": []
          }
        ]
      },
      "expected": "invalid-attribute"
    },
    {
      "id": "attr-byte-budget",
      "profile": 1,
      "sample": {
        "type": "callout",
        "attrs": {
          "kind": "info",
          "metadata": {
            "label": "Тема",
            "tags": [
              "ru",
              "note"
            ],
            "pinned": true,
            "rank": 2
          }
        },
        "content": [
          {
            "type": "paragraph",
            "content": []
          }
        ]
      },
      "maxAttrBytes": 20,
      "expected": "attribute-bytes-exceeded"
    },
    {
      "id": "document-depth-budget",
      "profile": 1,
      "maxDepth": 1,
      "expected": "resource-limit-exceeded"
    },
    {
      "id": "prototype-name-is-not-node",
      "profile": 0,
      "sample": {
        "type": "constructor",
        "content": []
