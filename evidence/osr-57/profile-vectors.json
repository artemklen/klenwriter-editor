    {
      "id": "unbounded-string-descriptor-refused",
      "profile": 1,
      "overrideCalloutKindDescriptor": {
        "kind": "string"
      },
      "expected": "invalid-attribute-schema"
    },
    {
      "id": "invalid-list-descriptor-refused",
      "profile": 1,
      "overrideCalloutKindDescriptor": {
        "kind": "list",
        "maxItems": -1,
        "item": {
          "kind": "string",
          "maxBytes": 8
        }
      },
      "expected": "invalid-attribute-schema"
