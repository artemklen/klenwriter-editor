{
  "schema": 1,
  "rule": "klenwriter-canonical-json-v1",
  "provenance": {
    "license": "MIT OR Apache-2.0",
    "author": "Codex for owner-authorized KlenWriter Editor OSR-77",
    "input": "Independently authored synthetic JSON, no CMS fixture/user payload copied",
    "expected": "Literal reviewed expected UTF-8 strings; not generated by the serializer under test"
  },
  "cases": [
    {
      "id": "scalar-key-order",
      "input": "{\"😀\":1,\"\\ue000\":2,\"\":0,\"Я\":3,\"a\":4}",
      "expected": "{\"\":0,\"a\":4,\"Я\":3,\"\":2,\"😀\":1}"
    },
    {
      "id": "escaped-supplementary-pair",
      "input": "{\"\\ud83d\\ude00\":1,\"\\ue000\":2}",
      "expected": "{\"\":2,\"😀\":1}"
    },
    {
      "id": "scalar-prefix-order",
      "input": "{\"😀z\":1,\"😀\":2,\"a😀\":3,\"a\\ue000\":4}",
      "expected": "{\"a\":4,\"a😀\":3,\"😀\":2,\"😀z\":1}"
    },
    {
      "id": "no-unicode-normalization",
      "input": "{\"é\":\"é\",\"e\\u0301\":\"e\\u0301\"}",
      "expected": "{\"é\":\"é\",\"é\":\"é\"}"
    },
    {
      "id": "array-order",
      "input": "[{\"z\":1,\"a\":2},true,null,false,\"Я\"]",
      "expected": "[{\"a\":2,\"z\":1},true,null,false,\"Я\"]"
    },
    {
      "id": "json-control-escaping",
      "input": "\"\\u0000\\b\\f\\n\\r\\t\\u000b\\\"\\\\\\/\"",
      "expected": "\"\\u0000\\b\\f\\n\\r\\t\\u000b\\\"\\\\/\""
    },
    {
      "id": "literal-unicode",
      "input": "\"\\u2028\\u2029\\u007f\\ud83d\\ude00\"",
      "expected": "\"  😀\""
    },
    {
      "id": "positive-zero",
      "input": "0",
      "expected": "0"
    },
    {
      "id": "negative-zero",
      "input": "-0",
      "expected": "-0.0"
    },
    {
      "id": "float-zero",
      "input": "0.0",
      "expected": "0.0"
    },
    {
      "id": "negative-float-zero",
      "input": "-0.00",
      "expected": "-0.0"
    },
    {
      "id": "integer-one",
      "input": "1",
      "expected": "1"
    },
    {
      "id": "float-one",
      "input": "1.00",
      "expected": "1.0"
    },
    {
      "id": "exponent-one",
      "input": "1E+00",
      "expected": "1.0"
    },
    {
      "id": "two53-minus-one",
      "input": "9007199254740991",
      "expected": "9007199254740991"
    },
    {
      "id": "two53",
      "input": "9007199254740992",
      "expected": "9007199254740992"
    },
    {
      "id": "two53-plus-one",
      "input": "9007199254740993",
      "expected": "9007199254740993"
    },
    {
      "id": "u64-max",
      "input": "18446744073709551615",
      "expected": "18446744073709551615"
    },
    {
      "id": "i64-min",
      "input": "-9223372036854775808",
      "expected": "-9223372036854775808"
    },
    {
      "id": "negative-exact-integer",
      "input": "-9007199254740993",
      "expected": "-9007199254740993"
    },
    {
      "id": "integer-over-u64",
      "input": "18446744073709551616",
      "expected": "1.8446744073709552e+19"
    },
    {
      "id": "integer-under-i64",
      "input": "-9223372036854775809",
      "expected": "-9.223372036854776e+18"
    },
    {
      "id": "exponent21",
      "input": "1e21",
      "expected": "1e+21"
    },
    {
      "id": "negative-exponent21",
      "input": "-1E21",
      "expected": "-1e+21"
    },
    {
      "id": "large-float-threshold",
      "input": "1e16",
      "expected": "1e+16"
    },
    {
      "id": "large-integer-retained",
      "input": "10000000000000000",
      "expected": "10000000000000000"
    },
    {
      "id": "large-fixed-float",
      "input": "1e15",
      "expected": "1000000000000000.0"
    },
    {
      "id": "small-fixed-threshold",
      "input": "1e-5",
      "expected": "0.00001"
    },
    {
      "id": "small-scientific-threshold",
      "input": "1e-6",
      "expected": "1e-6"
    },
    {
      "id": "decimal-fraction",
      "input": "1.2500",
      "expected": "1.25"
    },
    {
      "id": "negative-fraction",
      "input": "-12.50",
      "expected": "-12.5"
    },
    {
      "id": "underflow",
      "input": "1e-999",
      "expected": "0.0"
    },
    {
      "id": "negative-underflow",
      "input": "-1e-999",
      "expected": "-0.0"
    },
    {
      "id": "duplicate-last-wins",
      "input": "{\"b\":1,\"a\":2,\"b\":3}",
      "expected": "{\"a\":2,\"b\":3}"
    },
    {
      "id": "zero-large-exponent",
      "input": "0e999999999999",
      "expected": "0.0"
    },
    {
      "id": "unpaired-high-value",
      "input": "\"\\ud800\"",
      "refuse": true
    },
    {
      "id": "unpaired-low-key",
      "input": "{\"\\udfff\":1}",
      "refuse": true
    },
    {
      "id": "leading-zero",
      "input": "01",
      "refuse": true
    },
    {
      "id": "missing-fraction",
      "input": "1.",
      "refuse": true
    },
    {
      "id": "missing-exponent",
      "input": "1e+",
      "refuse": true
    },
    {
      "id": "nonfinite-token",
      "input": "NaN",
      "refuse": true
    },
    {
      "id": "infinite-overflow",
      "input": "1e400",
      "refuse": true
    },
    {
      "id": "invalid-trailing",
      "input": "{}x",
      "refuse": true
    },
    {
      "id": "numeric-and-prototype-keys",
      "input": "{\"2\":\"two\",\"constructor\":false,\"10\":\"ten\",\"__proto__\":null}",
      "expected": "{\"10\":\"ten\",\"2\":\"two\",\"__proto__\":null,\"constructor\":false}"
    },
    {
      "id": "default-parser-double-rounding",
      "input": "9007199254740993.0",
      "expected": "9007199254740994.0"
    }
  ]
}
